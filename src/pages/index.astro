---
import Layout from '../layouts/Layout.astro';
import { profile, socials } from '../data/profile';
---

<Layout title={`${profile.name} · ${profile.username}`}>
	<main class="profile-shell">
		<div class="ambient ambient-one" aria-hidden="true"></div>
		<div class="ambient ambient-two" aria-hidden="true"></div>

		<div class="profile-card">
			<header class="topbar">
				<a class="wordmark" href="/" aria-label="Volver al inicio">LinktrFree</a>
				<button class="share-button" type="button" aria-label="Compartir perfil" data-share>
					<svg class="share-icon share-icon-default" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V3m0 0L7.5 7.5M12 3l4.5 4.5M5 12.5v6A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5v-6" /></svg>
					<svg class="share-icon share-icon-success" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7" /></svg>
					<span class="share-tooltip" role="status" data-share-label>Compartir perfil</span>
				</button>
			</header>

			<section class="profile" aria-labelledby="profile-name">
				<div class="avatar"><img src="/logov1.png" alt="Logo de Queso Caliente" /></div>
				<h1 id="profile-name">{profile.username}</h1>
				<p class="display-name">{profile.name}</p>
				<p class="bio">{profile.bio}</p>

				<nav class="socials" aria-label="Redes sociales">
					{socials.map((social) => (
						<a href={social.href} class={`social social-${social.icon}`} aria-label={social.label} target="_blank" rel="noreferrer">
							{social.icon === 'instagram' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.4" cy="6.7" r="1" class="fill" /></svg>}
							{social.icon === 'twitch' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h16v11l-5 5h-4l-3 3v-3H5V3Z" /><path d="M10 8v4M15 8v4" /></svg>}
							{social.icon === 'youtube' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.3 7.1a2.5 2.5 0 0 0-1.8-1.8C16.9 5 12 5 12 5s-4.9 0-6.5.3a2.5 2.5 0 0 0-1.8 1.8C3.4 8.7 3.4 12 3.4 12s0 3.3.3 4.9a2.5 2.5 0 0 0 1.8 1.8c1.6.3 6.5.3 6.5.3s4.9 0 6.5-.3a2.5 2.5 0 0 0 1.8-1.8c.3-1.6.3-4.9.3-4.9s0-3.3-.3-4.9Z" /><path class="solid" d="m10 15.5 5-3.5-5-3.5v7Z" /></svg>}
							{social.icon === 'tiktok' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.7 4.1c.4 2 1.5 3.2 3.4 3.3v3a6.8 6.8 0 0 1-3.3-.9v5.9a5.1 5.1 0 1 1-4.4-5v3.1a2 2 0 1 0 1.5 1.9V4.1h2.8Z" /></svg>}
							{social.icon === 'x' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 4 5.5 6.6L5.3 20h2.4l3.9-7 5.8 7H19l-5.8-7L19 4h-2.4l-3.5 6.4L7.8 4H5Z" /></svg>}
						</a>
					))}
				</nav>

			</section>

			<section class="links" aria-label="Enlaces principales">
				{profile.links.map((link, index) => (
					<a class={`link-card ${link.tone === 'hot' ? 'link-card-hot' : ''}`} href={link.href} id={index === 0 ? 'proyecto' : undefined} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
						<span class="link-icon" aria-hidden="true">
							{link.icon === 'twitch' && <svg viewBox="0 0 24 24"><path d="M5 3h16v11l-5 5h-4l-3 3v-3H5V3Z" /><path d="M10 8v4M15 8v4" /></svg>}
							{link.icon === 'book' && <svg viewBox="0 0 24 24"><path d="M5 5.5A2.5 2.5 0 0 1 7.5 3H19v16H7.5A2.5 2.5 0 0 0 5 21V5.5Z" /><path d="M5 5.5v15M8.5 7H15M8.5 10H16" /></svg>}
							{link.icon === 'instagram' && <svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.4" cy="6.7" r="1" class="fill" /></svg>}
							{link.icon === 'tiktok' && <svg viewBox="0 0 24 24"><path d="M15.7 4.1c.4 2 1.5 3.2 3.4 3.3v3a6.8 6.8 0 0 1-3.3-.9v5.9a5.1 5.1 0 1 1-4.4-5v3.1a2 2 0 1 0 1.5 1.9V4.1h2.8Z" /></svg>}
							{link.icon === 'x' && <svg viewBox="0 0 24 24"><path d="m5 4 5.5 6.6L5.3 20h2.4l3.9-7 5.8 7H19l-5.8-7L19 4h-2.4l-3.5 6.4L7.8 4H5Z" /></svg>}
						</span>
						<span class="link-copy"><strong>{link.label}</strong><small>{link.detail}</small></span>
						<span class="arrow" aria-hidden="true">↗</span>
					</a>
				))}
			</section>

		</div>

		<footer>© linktrfree</footer>
	</main>
</Layout>

<script>
	const shareButton = document.querySelector('[data-share]');
	const shareLabel = document.querySelector('[data-share-label]');

	shareButton?.addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(window.location.href);
			if (shareLabel) shareLabel.textContent = 'Enlace copiado';
			shareButton?.setAttribute('data-shared', 'true');
			shareButton?.setAttribute('data-shared', 'true');
		} catch {
			if (shareLabel) shareLabel.textContent = 'Copia la URL del perfil';
		}
		window.setTimeout(() => {
			if (shareLabel) shareLabel.textContent = 'Compartir perfil';
			shareButton?.removeAttribute('data-shared');
		}, 1800);
	});
</script>

<style>
	:global(:root) {
		--color-canvas: oklch(0% 0 0);
		--color-surface: oklch(11% 0 0);
		--color-surface-hot: oklch(96% 0 0);
		--color-text-hot: oklch(8% 0 0);
		--color-text: oklch(94% 0 0);
		--color-text-muted: oklch(68% 0 0);
		--color-border-subtle: oklch(100% 0 0 / 0.16);
		--color-border-hot: oklch(100% 0 0 / 0.3);
		--shadow-card: 0 1px 2px oklch(0% 0 0 / 0.16), 0 8px 24px oklch(0% 0 0 / 0.12), 0 20px 55px oklch(0% 0 0 / 0.1);
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: var(--color-text);
		background: var(--color-canvas);
	}

	:global(body) { min-width: 320px; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }

	.profile-shell { position: relative; isolation: isolate; display: flex; flex-direction: column; align-items: center; min-height: 100dvh; overflow: hidden; padding: 28px 20px 36px; background: radial-gradient(circle at 50% -18%, oklch(24% 0 0 / 0.48), transparent 38rem), var(--color-canvas); }
	.ambient { position: absolute; z-index: -1; border-radius: 999px; filter: blur(70px); pointer-events: none; }
	.ambient-one { width: 210px; height: 210px; top: 30%; left: -130px; background: oklch(40% 0 0 / 0.16); animation: ambient-drift-one 18s ease-in-out infinite alternate; }
	.ambient-two { width: 190px; height: 190px; right: -120px; bottom: 16%; background: oklch(45% 0 0 / 0.12); animation: ambient-drift-two 21s ease-in-out infinite alternate-reverse; }
	.profile-card { position: relative; isolation: isolate; width: min(100%, 760px); overflow: hidden; padding: 22px 40px 30px; border: 1px solid oklch(100% 0 0 / 0.14); border-radius: 30px; background: linear-gradient(145deg, oklch(9% 0 0), oklch(12% 0 0) 58%, oklch(8% 0 0)); box-shadow: 0 2px 3px oklch(0% 0 0 / 0.35), 0 18px 46px oklch(0% 0 0 / 0.5); animation: profile-enter 260ms cubic-bezier(0.32, 0.72, 0, 1) both; }
	.profile-card::before, .profile-card::after { position: absolute; z-index: -1; display: block; border-radius: 999px; content: ''; pointer-events: none; }
	.profile-card::before { width: 360px; height: 240px; top: 14%; left: -100px; background: oklch(24% 0 0 / 0.32); transform: rotate(-18deg); }
	.profile-card::after { width: 420px; height: 220px; right: -170px; bottom: 8%; background: oklch(28% 0 0 / 0.22); transform: rotate(20deg); }

	.topbar { display: flex; justify-content: space-between; align-items: center; width: 100%; }
	.wordmark { color: var(--color-text); font-size: 18px; font-weight: 800; letter-spacing: -0.08em; text-decoration: none; }
	.share-button { position: relative; display: grid; place-items: center; width: 44px; height: 44px; color: var(--color-text); border: 1px solid var(--color-border-subtle); border-radius: 50%; background: oklch(100% 0 0 / 0.06); cursor: pointer; transition: background-color 150ms ease-out, transform 150ms ease-out; }
	.share-button svg { width: 19px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
	.share-icon-success { display: none; }
	.share-button:active { transform: scale(0.94); }
	.share-button[data-shared] .share-icon-default { display: none; }
	.share-button[data-shared] .share-icon-success { display: block; }
	.share-button:focus-visible, .social:focus-visible, .link-card:focus-visible { outline: 3px solid oklch(100% 0 0); outline-offset: 3px; }
	.share-tooltip { position: absolute; top: calc(100% + 8px); right: 0; width: max-content; padding: 6px 9px; color: var(--color-text); border: 1px solid var(--color-border-subtle); border-radius: 8px; background: oklch(12% 0 0); font-size: 11px; font-weight: 600; opacity: 0; pointer-events: none; transform: translateY(-3px); transition: opacity 150ms ease-out, transform 150ms ease-out; }
	.share-button:focus-visible .share-tooltip, .share-button[data-shared] .share-tooltip { opacity: 1; transform: translateY(0); }

	.profile { display: flex; flex-direction: column; align-items: center; width: 100%; padding: 42px 0 28px; text-align: center; }
	.avatar { display: grid; place-items: center; width: 94px; height: 94px; margin-bottom: 18px; overflow: hidden; border: 1px solid oklch(100% 0 0 / 0.22); border-radius: 30px; background: oklch(12% 0 0); box-shadow: 0 0 0 6px oklch(100% 0 0 / 0.04), 0 10px 30px oklch(0% 0 0 / 0.4); transition: transform 150ms ease; }
	.avatar img { display: block; width: 100%; height: 100%; object-fit: contain; }
	h1 { margin: 0; font-size: clamp(30px, 7vw, 43px); font-weight: 800; letter-spacing: -0.055em; line-height: 1.02; text-wrap: balance; }
	.display-name { margin: 8px 0 0; color: oklch(68% 0 0); font-size: 13px; font-weight: 650; letter-spacing: 0.04em; }
	.bio { max-width: 37ch; margin: 14px auto 0; color: var(--color-text-muted); font-size: 15px; line-height: 1.55; text-wrap: balance; }

	.socials { display: flex; gap: 8px; margin-top: 23px; }
	.social { display: grid; place-items: center; width: 44px; height: 44px; color: var(--color-text); border: 1px solid transparent; border-radius: 14px; background: oklch(100% 0 0 / 0.055); transition: background-color 150ms ease-out, border-color 150ms ease-out, transform 150ms ease-out; }
	.social svg { width: 18px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
	.social svg .fill, .social svg .solid { fill: currentColor; stroke: none; }

	.links { display: flex; flex-direction: column; gap: 12px; width: 100%; }
	.link-card { position: relative; isolation: isolate; display: flex; align-items: center; min-height: 72px; overflow: hidden; padding: 8px 18px 8px 11px; color: var(--color-text); border: 1px solid var(--color-border-subtle); border-radius: 18px; background: var(--color-surface); box-shadow: var(--shadow-card); text-decoration: none; transition: transform 150ms ease, background-color 150ms ease, border-color 150ms ease; }
	.link-card::before { position: absolute; z-index: -1; inset: 0; background: linear-gradient(105deg, transparent 25%, oklch(100% 0 0 / 0.09) 48%, transparent 70%); content: ''; opacity: 0; pointer-events: none; transform: translateX(-110%); }
	.link-card:active { transform: translateY(1px) scale(0.99); }
	.link-card-hot { color: var(--color-text-hot); border-color: var(--color-border-hot); background: linear-gradient(100deg, var(--color-surface-hot), oklch(86% 0 0)); }
	.link-icon { display: grid; place-items: center; flex: 0 0 42px; height: 42px; color: oklch(100% 0 0 / 0.74); border: 1px solid oklch(100% 0 0 / 0.14); border-radius: 12px; background: oklch(100% 0 0 / 0.06); }
	.link-icon svg { width: 20px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
	.link-icon svg .fill { fill: currentColor; stroke: none; }
	.link-card-hot .link-icon { color: var(--color-text-hot); border-color: oklch(0% 0 0 / 0.22); background: oklch(0% 0 0 / 0.08); }
	.link-card-hot .link-icon svg { color: var(--color-text-hot); stroke: var(--color-text-hot); }
	.link-copy { display: flex; flex: 1; flex-direction: column; gap: 3px; min-width: 0; margin-left: 13px; }
	.link-copy strong { font-size: 15px; font-weight: 700; line-height: 1.25; }
	.link-copy small { overflow: hidden; color: oklch(78% 0 0 / 0.62); font-size: 12px; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
	.link-card-hot .link-copy small { color: oklch(8% 0 0 / 0.62); }
	.arrow { margin-left: 12px; color: oklch(100% 0 0 / 0.62); font-size: 24px; font-weight: 300; line-height: 1; transition: transform 150ms ease-out; }
	.link-card-hot .arrow { color: var(--color-text-hot); }

	@media (hover: hover) and (pointer: fine) {
		.share-button:hover { background: oklch(100% 0 0 / 0.13); }
		.share-button:hover .share-tooltip { opacity: 1; transform: translateY(0); }
		.avatar:hover { transform: scale(1.02); }
		.social:hover { border-color: var(--color-border-subtle); background: oklch(100% 0 0 / 0.11); transform: translateY(-2px); }
		.link-card:hover { border-color: oklch(100% 0 0 / 0.25); background: oklch(16% 0 0); transform: translateY(-2px); }
		.link-card:hover::before { opacity: 1; transform: translateX(110%); transition: opacity 150ms ease, transform 450ms cubic-bezier(0.32, 0.72, 0, 1); }
		.link-card:hover .link-icon { transform: translateY(-1px); }
		.link-card:hover .arrow { transform: translate(2px, -2px); }
		.link-card-hot:hover { border-color: oklch(100% 0 0 / 0.42); background: linear-gradient(100deg, var(--color-surface-hot), oklch(86% 0 0)); transform: none; }
		.link-card-hot:hover::before { opacity: 0; transform: none; }
	}
	@keyframes profile-enter { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
	@keyframes ambient-drift-one { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(42px, -24px, 0); } }
	@keyframes ambient-drift-two { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-34px, 28px, 0); } }
	footer { display: flex; align-items: center; gap: 8px; margin-top: auto; padding-top: 42px; color: oklch(62% 0 0 / 0.58); font-size: 11px; font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; }
	.footer-dot { width: 5px; height: 5px; border-radius: 50%; background: oklch(100% 0 0); }

	@media (max-width: 560px) { .profile-card { padding: 18px 16px 24px; border-radius: 24px; } }
	@media (min-width: 640px) { .profile-shell { padding-top: 34px; } .profile { padding-top: 54px; padding-bottom: 34px; } }
	@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; } }
</style>
