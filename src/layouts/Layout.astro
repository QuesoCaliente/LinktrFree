---
interface Props {
	title?: string;
}

const { title = 'Queso Caliente' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#000000" />
		<meta name="description" content="Todos los enlaces de Queso Caliente en un solo lugar." />
		<link rel="icon" type="image/png" sizes="800x800" href="/logov1.png" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Todos los enlaces de Queso Caliente en un solo lugar." />
		<meta property="og:image" content="/logov1.png" />
		<meta property="og:image:alt" content="Logo de Queso Caliente" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content="Todos los enlaces de Queso Caliente en un solo lugar." />
		<meta name="twitter:image" content="/logov1.png" />
		<meta name="twitter:image:alt" content="Logo de Queso Caliente" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) { min-width: 320px; background: #000; }
	:global(body) { margin: 0; min-width: 320px; min-height: 100vh; }
	:global(button), :global(a) { font: inherit; }
</style>
